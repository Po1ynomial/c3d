      "style": { "shaft": "dashed" }
    },

    {
      "id": "front",
      "from": "U",
      "to": "V",
      "label": { "text": "x", "t": 0.25 },
      "style": { "color": "#15803d" }
    },
    { "id": "diag", "from": "C", "to": "Q", "label": { "text": "y", "t": 0.75 } },

    {
      "id": "e",
      "from": "S",
      "to": "S",
      "label": "e",
      "loop": { "axis": [1, 0, 0], "radius": 0.45 }
