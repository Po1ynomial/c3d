    { "id": "P", "pos": [0, 0, -3], "label": "P" },
    { "id": "Q", "pos": [3, 0, -3], "label": "Q" },
    { "id": "U", "pos": [1.5, -1.5, -1.5], "label": "U" },
    { "id": "V", "pos": [1.5, 1.5, -1.5], "label": "V" },
    { "id": "S", "pos": [6, 0, 0], "label": "S" },
    { "id": "T", "pos": [6, 0, -3], "label": "T" },
